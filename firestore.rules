rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidUser(data) {
      return data.uid is string && data.email is string;
    }

    function isValidTransaction(data) {
      return data.userId is string && 
             data.type in ['income', 'expense'] &&
             data.amount is number &&
             data.date is string &&
             data.month is string &&
             data.month.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function isValidDebt(data) {
      return data.userId is string &&
             data.name is string &&
             data.name.size() > 0 &&
             data.totalAmount is number &&
             data.remainingAmount is number;
    }

    // Match Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email']);

      match /transactions/{transactionId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransaction(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidTransaction(incoming()) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      match /debts/{debtId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDebt(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidDebt(incoming()) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
